# Copia este archivo a /var/www/belly/api/.env
# No subas este archivo con claves reales.

CI_ENVIRONMENT = production

app.baseURL = 'https://api.micrm.space/'
app.forceGlobalSecureRequests = false

database.default.hostname = localhost
database.default.database = crm_belly
database.default.username = belly
database.default.password = CAMBIA_ESTA_CLAVE
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# php spark key:generate --force
encryption.key =

SOCKET_CLAVE = CAMBIA_ESTA_CLAVE_LARGA
SOCKET_HOST = 127.0.0.1
SOCKET_PUERTO = 4000
SOCKET_URL = http://127.0.0.1:4000
SOCKET_API_URL = http://127.0.0.1:8080
SOCKET_ORIGENES = https://app.micrm.space

# Stickers (Giphy). WhatsApp no abre su tienda; esta es la API pública de stickers.
# Gratis en https://developers.giphy.com/dashboard/
GIPHY_CLAVE =
